# Dependencies and package-manager caches
node_modules/
.npm/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/install-state.gz
.pnp.*

# This repository uses npm; keep its lock file under version control.
yarn.lock
!/package-lock.json

# Build output and generated package archives
/dist/
/packages/*/dist/
/build/
*.tgz
*.tsbuildinfo

# Vite, lint and other tool caches
.vite/
.vite-temp/
.cache/
.eslintcache
.stylelintcache
.prettiercache
vite.config.*.timestamp-*

# Test and coverage output
coverage/
.nyc_output/
playwright-report/
test-results/

# Local environment files; keep shareable examples
.env
.env.*
!.env.example
!.env.*.example
!.env.sample
!.env.*.sample
*.local

# Logs and temporary runtime files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/
tmp/
temp/
pids/
*.pid
*.seed
*.pid.lock

# Editor-local files; keep useful shared VS Code configuration
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json
*.iml
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*~

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp
