{
  "name": "rsshook-excel",
  "version": "0.2.0",
  "description": "Configurable Excel import/export with custom headers and optional React hooks",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./browser": {
      "import": {
        "types": "./dist/browser.d.mts",
        "default": "./dist/browser.mjs"
      },
      "require": {
        "types": "./dist/browser.d.cts",
        "default": "./dist/browser.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.mts",
        "default": "./dist/react.mjs"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./worker": "./dist/worker.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "./dist/worker.mjs"
  ],
  "scripts": {
    "type-check": "tsc -p tsconfig.json",
    "build": "npm run type-check && vite build --config vite.config.mts && vite build --config vite.worker.config.mts && tsc -p tsconfig.json --noEmit false --emitDeclarationOnly && node scripts/build-types.mjs",
    "test": "npm run build && node --test tests/*.test.mjs tests/*.test.cjs && npm run test:types && npm run test:examples",
    "test:types": "node scripts/check-types.mjs",
    "test:examples": "tsc -p tsconfig.examples.json",
    "test:package": "npm run build && node scripts/check-package.mjs",
    "benchmark": "npm run build && node scripts/benchmark.mjs"
  },
  "dependencies": {
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.0.20",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "jsdom": "^26.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "typesVersions": {
    "*": {
      "react": [
        "dist/react.d.cts"
      ],
      "browser": [
        "dist/browser.d.cts"
      ]
    }
  },
  "author": "dss",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dss-time/rhook.git",
    "directory": "packages/excel"
  },
  "homepage": "https://github.com/dss-time/rhook/tree/main/packages/excel#readme",
  "bugs": {
    "url": "https://github.com/dss-time/rhook/issues"
  },
  "keywords": [
    "excel",
    "xlsx",
    "csv",
    "react",
    "hooks",
    "import",
    "export",
    "typescript"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
